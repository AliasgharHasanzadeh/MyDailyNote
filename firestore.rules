rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Hardened Primitives ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isOptionalString(val, maxLen) {
      return val == null || (val is string && val.size() <= maxLen);
    }

    function isOptionalId(val) {
      return val == null || isValidId(val);
    }

    function isStringList(listVal, maxItems, maxItemLen) {
      return listVal is list
        && listVal.size() <= maxItems
        && (listVal.size() == 0 || (listVal[0] is string && listVal[0].size() <= maxItemLen));
    }

    function hasUserProfile(userId) {
      return exists(/databases/$(database)/documents/users/$(userId))
        || existsAfter(/databases/$(database)/documents/users/$(userId));
    }

    // --- Validation Blueprints ---
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'photoURL', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() <= 120
        && data.photoURL is string && data.photoURL.size() <= 1000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFolder(data, folderId, userId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'name', 'parentId', 'icon',
          'isPinned', 'isExpanded', 'sortOrder', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'name', 'parentId', 'icon',
          'isPinned', 'isExpanded', 'sortOrder', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == folderId
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && isOptionalId(data.parentId)
        && data.icon is string && data.icon.size() <= 16
        && data.isPinned is bool
        && data.isExpanded is bool
        && data.sortOrder is number && data.sortOrder >= -10000 && data.sortOrder <= 100000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidJournalMetadata(meta) {
      return meta is map
        && meta.keys().hasOnly(['mood', 'rating', 'highlights'])
        && (!('mood' in meta) || isOptionalString(meta.mood, 40))
        && (!('rating' in meta) || meta.rating == null || (meta.rating is number && meta.rating >= 1 && meta.rating <= 5))
        && (!('highlights' in meta) || meta.highlights == null || isStringList(meta.highlights, 20, 200));
    }

    function isValidNote(data, noteId, userId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'title', 'content', 'plainText', 'parentFolderId',
          'icon', 'coverImage', 'tags', 'isFavorite', 'isPinned', 'isArchived',
          'sortOrder', 'journalDate', 'linkedNoteIds', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'title', 'content', 'plainText', 'parentFolderId',
          'icon', 'coverImage', 'tags', 'isFavorite', 'isPinned', 'isArchived',
          'sortOrder', 'journalDate', 'isCustomJournalTitle', 'journalMetadata',
          'linkedNoteIds', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == noteId
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.title is string && data.title.size() <= 300
        && data.content is map
        && data.plainText is string && data.plainText.size() <= 200000
        && isOptionalId(data.parentFolderId)
        && isOptionalString(data.icon, 16)
        && isOptionalString(data.coverImage, 500000)
        && isStringList(data.tags, 25, 40)
        && data.isFavorite is bool
        && data.isPinned is bool
        && data.isArchived is bool
        && data.sortOrder is number && data.sortOrder >= -10000 && data.sortOrder <= 100000
        && (data.journalDate == null || (data.journalDate is string && data.journalDate.size() == 10 && data.journalDate.matches('^\\d{4}-\\d{2}-\\d{2}$')))
        && (!('isCustomJournalTitle' in data) || data.isCustomJournalTitle == null || data.isCustomJournalTitle is bool)
        && (!('journalMetadata' in data) || data.journalMetadata == null || isValidJournalMetadata(data.journalMetadata))
        && isStringList(data.linkedNoteIds, 50, 128)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTask(data, taskId, userId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'title', 'description', 'status', 'priority',
          'dueDate', 'folderId', 'linkedNoteId', 'linkedGoalId',
          'completedAt', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'title', 'description', 'status', 'priority',
          'dueDate', 'folderId', 'linkedNoteId', 'linkedGoalId',
          'completedAt', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == taskId
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 300
        && data.description is string && data.description.size() <= 5000
        && data.status in ['todo', 'in_progress', 'done']
        && data.priority in ['low', 'medium', 'high']
        && (data.dueDate == null || (data.dueDate is string && data.dueDate.size() == 10 && data.dueDate.matches('^\\d{4}-\\d{2}-\\d{2}$')))
        && isOptionalId(data.folderId)
        && isOptionalId(data.linkedNoteId)
        && isOptionalId(data.linkedGoalId)
        && isOptionalString(data.completedAt, 40)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidGoal(data, goalId, userId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'title', 'description', 'horizon', 'targetDate',
          'progressMode', 'manualProgress', 'milestones', 'linkedNoteIds',
          'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'title', 'description', 'horizon', 'targetDate',
          'progressMode', 'manualProgress', 'milestones', 'linkedNoteIds',
          'status', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == goalId
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 300
        && data.description is string && data.description.size() <= 5000
        && data.horizon in ['short_term', 'long_term']
        && (data.targetDate == null || (data.targetDate is string && data.targetDate.size() == 10 && data.targetDate.matches('^\\d{4}-\\d{2}-\\d{2}$')))
        && data.progressMode in ['auto', 'manual']
        && data.manualProgress is number && data.manualProgress >= 0 && data.manualProgress <= 100
        && data.milestones is list && data.milestones.size() <= 50
        && (data.milestones.size() == 0 || (
          data.milestones[0] is map
          && data.milestones[0].keys().hasAll(['id', 'title', 'completed'])
          && data.milestones[0].keys().hasOnly(['id', 'title', 'completed'])
          && isValidId(data.milestones[0].id)
          && data.milestones[0].title is string && data.milestones[0].title.size() <= 200
          && data.milestones[0].completed is bool
        ))
        && isStringList(data.linkedNoteIds, 50, 128)
        && data.status in ['active', 'completed']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPreferences(data, prefId, userId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'theme', 'calendarLocale', 'rightSidebarOpen',
          'leftSidebarCollapsed', 'leftSidebarWidth', 'notesViewMode',
          'journalViewMode', 'taskViewMode', 'activeNoteId',
          'activeSection', 'activeFolderId', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'theme', 'calendarLocale', 'rightSidebarOpen',
          'leftSidebarCollapsed', 'leftSidebarWidth', 'notesViewMode',
          'journalViewMode', 'taskViewMode', 'activeNoteId',
          'activeSection', 'activeFolderId', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == prefId
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.theme in ['dark', 'light']
        && data.calendarLocale in ['en', 'fa']
        && data.rightSidebarOpen is bool
        && data.leftSidebarCollapsed is bool
        && data.leftSidebarWidth is number && data.leftSidebarWidth >= 180 && data.leftSidebarWidth <= 600
        && data.notesViewMode in ['list', 'compact', 'grid']
        && data.journalViewMode in ['calendar', 'timeline', 'list']
        && data.taskViewMode in ['list', 'kanban']
        && isOptionalId(data.activeNoteId)
        && data.activeSection in [
          'dashboard', 'quick_access', 'all_notes', 'favorites', 'recent',
          'journal', 'tasks', 'goals', 'archived', 'folder', 'editor'
        ]
        && isOptionalId(data.activeFolderId)
        && data.updatedAt is timestamp;
    }

    // --- Collection Rules ---
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']);
      allow delete: if false;

      match /folders/{folderId} {
        allow get: if isOwner(userId) && isValidId(folderId) && existing().ownerId == request.auth.uid;
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(folderId)
          && isValidFolder(incoming(), folderId, userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasUserProfile(userId);
        allow update: if isOwner(userId)
          && isValidId(folderId)
          && isValidFolder(incoming(), folderId, userId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'icon', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['parentId', 'isPinned', 'isExpanded', 'sortOrder', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'parentId', 'icon', 'isPinned', 'isExpanded', 'sortOrder', 'updatedAt'])
          );
        allow delete: if isOwner(userId) && isValidId(folderId) && existing().ownerId == request.auth.uid;
      }

      match /notes/{noteId} {
        allow get: if isOwner(userId) && isValidId(noteId) && existing().ownerId == request.auth.uid;
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(noteId)
          && isValidNote(incoming(), noteId, userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasUserProfile(userId);
        allow update: if isOwner(userId)
          && isValidId(noteId)
          && isValidNote(incoming(), noteId, userId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'plainText', 'isCustomJournalTitle', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'parentFolderId', 'icon', 'coverImage', 'tags', 'isFavorite', 'isPinned', 'isArchived', 'sortOrder', 'journalDate', 'isCustomJournalTitle', 'journalMetadata', 'linkedNoteIds', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'plainText', 'parentFolderId', 'icon', 'coverImage', 'tags', 'isFavorite', 'isPinned', 'isArchived', 'sortOrder', 'journalDate', 'isCustomJournalTitle', 'journalMetadata', 'linkedNoteIds', 'updatedAt'])
          );
        allow delete: if isOwner(userId) && isValidId(noteId) && existing().ownerId == request.auth.uid;
      }

      match /tasks/{taskId} {
        allow get: if isOwner(userId) && isValidId(taskId) && existing().ownerId == request.auth.uid;
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(taskId)
          && isValidTask(incoming(), taskId, userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasUserProfile(userId);
        allow update: if isOwner(userId)
          && isValidId(taskId)
          && isValidTask(incoming(), taskId, userId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'completedAt', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'status', 'priority', 'dueDate', 'folderId', 'linkedNoteId', 'linkedGoalId', 'completedAt', 'updatedAt'])
          );
        allow delete: if isOwner(userId) && isValidId(taskId) && existing().ownerId == request.auth.uid;
      }

      match /goals/{goalId} {
        allow get: if isOwner(userId) && isValidId(goalId) && existing().ownerId == request.auth.uid;
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(goalId)
          && isValidGoal(incoming(), goalId, userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasUserProfile(userId);
        allow update: if isOwner(userId)
          && isValidId(goalId)
          && isValidGoal(incoming(), goalId, userId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['milestones', 'status', 'manualProgress', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'horizon', 'targetDate', 'progressMode', 'manualProgress', 'milestones', 'linkedNoteIds', 'status', 'updatedAt'])
          );
        allow delete: if isOwner(userId) && isValidId(goalId) && existing().ownerId == request.auth.uid;
      }

      match /preferences/{prefId} {
        allow get: if isOwner(userId) && isValidId(prefId) && existing().ownerId == request.auth.uid;
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(prefId)
          && isValidPreferences(incoming(), prefId, userId)
          && incoming().updatedAt == request.time
          && hasUserProfile(userId);
        allow update: if isOwner(userId)
          && isValidId(prefId)
          && isValidPreferences(incoming(), prefId, userId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'theme', 'calendarLocale', 'rightSidebarOpen', 'leftSidebarCollapsed',
            'leftSidebarWidth', 'notesViewMode', 'journalViewMode', 'taskViewMode',
            'activeNoteId', 'activeSection', 'activeFolderId', 'updatedAt'
          ]);
        allow delete: if isOwner(userId) && isValidId(prefId) && existing().ownerId == request.auth.uid;
      }
    }
  }
}
