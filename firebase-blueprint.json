{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated workspace owner profile metadata.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Authentication user UID."
        },
        "displayName": {
          "type": "string",
          "maxLength": 120,
          "description": "Display name shown in workspace account badge."
        },
        "photoURL": {
          "type": "string",
          "maxLength": 1000,
          "description": "Avatar image URL from Google Auth."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when profile was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when profile was last updated."
        }
      },
      "required": ["uid", "displayName", "photoURL", "createdAt", "updatedAt"]
    },
    "Folder": {
      "title": "Folder",
      "description": "Hierarchical workspace folder or group.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "parentId": {
          "type": "string",
          "maxLength": 128
        },
        "icon": {
          "type": "string",
          "maxLength": 16
        },
        "isPinned": {
          "type": "boolean"
        },
        "isExpanded": {
          "type": "boolean"
        },
        "sortOrder": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerId",
        "name",
        "parentId",
        "icon",
        "isPinned",
        "isExpanded",
        "sortOrder",
        "createdAt",
        "updatedAt"
      ]
    },
    "Note": {
      "title": "Note",
      "description": "Freeform TipTap digital notebook page or daily journal entry.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "maxLength": 300
        },
        "content": {
          "type": "object",
          "description": "TipTap JSONContent tree."
        },
        "plainText": {
          "type": "string",
          "maxLength": 200000
        },
        "parentFolderId": {
          "type": "string",
          "maxLength": 128
        },
        "icon": {
          "type": "string",
          "maxLength": 16
        },
        "coverImage": {
          "type": "string",
          "maxLength": 500000
        },
        "tags": {
          "type": "array"
        },
        "isFavorite": {
          "type": "boolean"
        },
        "isPinned": {
          "type": "boolean"
        },
        "isArchived": {
          "type": "boolean"
        },
        "sortOrder": {
          "type": "number"
        },
        "journalDate": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "isCustomJournalTitle": {
          "type": "boolean"
        },
        "journalMetadata": {
          "type": "object"
        },
        "linkedNoteIds": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerId",
        "title",
        "content",
        "plainText",
        "parentFolderId",
        "icon",
        "coverImage",
        "tags",
        "isFavorite",
        "isPinned",
        "isArchived",
        "sortOrder",
        "journalDate",
        "linkedNoteIds",
        "createdAt",
        "updatedAt"
      ]
    },
    "Task": {
      "title": "Task",
      "description": "Personal task item optionally linked to a folder, note, or goal.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "description": {
          "type": "string",
          "maxLength": 5000
        },
        "status": {
          "type": "string",
          "enum": ["todo", "in_progress", "done"]
        },
        "priority": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "dueDate": {
          "type": "string",
          "maxLength": 10
        },
        "folderId": {
          "type": "string",
          "maxLength": 128
        },
        "linkedNoteId": {
          "type": "string",
          "maxLength": 128
        },
        "linkedGoalId": {
          "type": "string",
          "maxLength": 128
        },
        "completedAt": {
          "type": "string",
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerId",
        "title",
        "description",
        "status",
        "priority",
        "dueDate",
        "folderId",
        "linkedNoteId",
        "linkedGoalId",
        "completedAt",
        "createdAt",
        "updatedAt"
      ]
    },
    "Goal": {
      "title": "Goal",
      "description": "Personal short-term or long-term goal with milestones.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "description": {
          "type": "string",
          "maxLength": 5000
        },
        "horizon": {
          "type": "string",
          "enum": ["short_term", "long_term"]
        },
        "targetDate": {
          "type": "string",
          "maxLength": 10
        },
        "progressMode": {
          "type": "string",
          "enum": ["auto", "manual"]
        },
        "manualProgress": {
          "type": "number"
        },
        "milestones": {
          "type": "array"
        },
        "linkedNoteIds": {
          "type": "array"
        },
        "status": {
          "type": "string",
          "enum": ["active", "completed"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerId",
        "title",
        "description",
        "horizon",
        "targetDate",
        "progressMode",
        "manualProgress",
        "milestones",
        "linkedNoteIds",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "WorkspacePreferences": {
      "title": "WorkspacePreferences",
      "description": "User UI theme, calendar locale, and layout preferences.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "theme": {
          "type": "string",
          "enum": ["dark", "light"]
        },
        "calendarLocale": {
          "type": "string",
          "enum": ["en", "fa"]
        },
        "rightSidebarOpen": {
          "type": "boolean"
        },
        "leftSidebarCollapsed": {
          "type": "boolean"
        },
        "leftSidebarWidth": {
          "type": "number"
        },
        "notesViewMode": {
          "type": "string",
          "enum": ["list", "compact", "grid"]
        },
        "journalViewMode": {
          "type": "string",
          "enum": ["calendar", "timeline", "list"]
        },
        "taskViewMode": {
          "type": "string",
          "enum": ["list", "kanban"]
        },
        "activeNoteId": {
          "type": "string",
          "maxLength": 128
        },
        "activeSection": {
          "type": "string",
          "enum": [
            "dashboard",
            "quick_access",
            "all_notes",
            "favorites",
            "recent",
            "journal",
            "tasks",
            "goals",
            "archived",
            "folder",
            "editor"
          ]
        },
        "activeFolderId": {
          "type": "string",
          "maxLength": 128
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerId",
        "theme",
        "calendarLocale",
        "rightSidebarOpen",
        "leftSidebarCollapsed",
        "leftSidebarWidth",
        "notesViewMode",
        "journalViewMode",
        "taskViewMode",
        "activeNoteId",
        "activeSection",
        "activeFolderId",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile document scoped to owner UID."
    },
    "/users/{userId}/folders/{folderId}": {
      "schema": { "$ref": "#/entities/Folder" },
      "description": "User workspace folders and nested groups."
    },
    "/users/{userId}/notes/{noteId}": {
      "schema": { "$ref": "#/entities/Note" },
      "description": "User notebook pages and daily journal entries."
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/Task" },
      "description": "User tasks and kanban items."
    },
    "/users/{userId}/goals/{goalId}": {
      "schema": { "$ref": "#/entities/Goal" },
      "description": "User short-term and long-term goals."
    },
    "/users/{userId}/preferences/{prefId}": {
      "schema": { "$ref": "#/entities/WorkspacePreferences" },
      "description": "User workspace preferences document."
    }
  }
}
